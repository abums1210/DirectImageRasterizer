#include <winres.h>

#ifndef TARGET_FILENAME
#define TARGET_FILENAME "DirectImageRasterizer.asi"
#endif

#ifndef TARGET_INTERNALNAME
#define TARGET_INTERNALNAME "DirectImageRasterizer"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,2,2,0
PRODUCTVERSION  2,2,2,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "CharlesVercetti"
            VALUE "FileDescription",  "DirectImageRasterizer for GTA Trilogy"
            VALUE "FileVersion",      "2.2.2.0"
            VALUE "InternalName",     TARGET_INTERNALNAME
            VALUE "LegalCopyright",   "Copyright (C) CharlesVercetti"
            VALUE "OriginalFilename", TARGET_FILENAME
            VALUE "ProductName",      "DirectImageRasterizer"
            VALUE "ProductVersion",   "2.2.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
